<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Salter.App.Views.DetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Salter.App.Controls"
    xmlns:local="using:Salter.App.Views"
    xmlns:vm="using:Salter.Presentation.ViewModels">

  <UserControl.Resources>
    <!-- One menu shared by every tag pill; its item is labelled for the pill it opens on. -->
    <MenuFlyout x:Key="TagMenu" Opening="OnTagMenuOpening">
      <MenuFlyoutItem Click="OnExcludeTagClick">
        <MenuFlyoutItem.Icon>
          <FontIcon Glyph="&#xED1A;" />
        </MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
    </MenuFlyout>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header, like a title bar: back, resolution and size (secondary), open on wallhaven; a hairline below. -->
    <Grid Grid.Row="0" Height="48" Padding="8,0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
          x:Name="BackButton"
          Grid.Column="0"
          AutomationProperties.Name="{x:Bind local:Ui.Text('Detail_Back')}"
          Command="{x:Bind Detail.CloseCommand}"
          Style="{StaticResource TitleBarButtonStyle}"
          ToolTipService.ToolTip="{x:Bind local:Ui.Text('Detail_Back')}">
        <FontIcon FontSize="16" Glyph="&#xE72B;" />
      </Button>
      <TextBlock
          Grid.Column="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Style="{StaticResource BodyLineTextStyle}"
          Text="{x:Bind Detail.Summary, Mode=OneWay}"
          TextTrimming="CharacterEllipsis" />
      <HyperlinkButton
          Grid.Column="2"
          AutomationProperties.Name="{x:Bind local:Ui.Text('Detail_OpenInBrowser')}"
          NavigateUri="{x:Bind Detail.WallhavenPage, Mode=OneWay}"
          Style="{StaticResource TitleBarLinkButtonStyle}"
          ToolTipService.ToolTip="{x:Bind local:Ui.Text('Detail_OpenInBrowser')}">
        <FontIcon FontSize="15" Glyph="&#xE8A7;" />
      </HyperlinkButton>
      <Rectangle Grid.ColumnSpan="3" Margin="-8,0" VerticalAlignment="Bottom" Style="{StaticResource DividerStyle}" />
    </Grid>

    <!-- Preview, tags and target; scrolls when the flyout is shorter than usual. -->
    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
      <StackPanel Padding="12,12,12,12">
        <!-- A rounded card; the image is the frame's background, so the rounded corners clip it. -->
        <Border
            Height="196"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            CornerRadius="{StaticResource CardCornerRadius}">
          <Border
              x:Name="Preview"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource CardCornerRadius}" />
        </Border>

        <ItemsControl Margin="0,12,0,0" IsTabStop="False" ItemsSource="{x:Bind Detail.Tags, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <!-- Subtle pills. Right-click (or press and hold) a pill to leave its tag out of the feed. -->
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border
                  Padding="10,3,10,4"
                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  ContextFlyout="{StaticResource TagMenu}"
                  CornerRadius="{StaticResource SmallPillCornerRadius}"
                  Tag="{x:Bind}">
                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="#" /><Run Text="{x:Bind}" /></TextBlock>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Shown only with more than one display: a segmented control. -->
        <StackPanel Margin="0,16,0,0" Spacing="8" Visibility="{x:Bind Detail.ShowTargets, Mode=OneWay}">
          <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind local:Ui.Text('Detail_ApplyTo')}" />
          <Border Style="{StaticResource SegmentedHostStyle}">
            <ItemsRepeater ItemsSource="{x:Bind Detail.Targets, Mode=OneWay}">
              <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MaximumRowsOrColumns="3"
                    MinColumnSpacing="2"
                    MinItemWidth="60"
                    MinRowSpacing="2" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:ChoiceItem">
                  <RadioButton
                      Checked="OnTargetChecked"
                      Click="OnTargetClick"
                      Content="{x:Bind Label}"
                      GroupName="Target"
                      IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                      Style="{StaticResource SegmentRadioStyle}"
                      Tag="{x:Bind}" />
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Primary action and credit, below a hairline. -->
    <Rectangle Grid.Row="2" VerticalAlignment="Top" Style="{StaticResource DividerStyle}" />
    <StackPanel Grid.Row="2" Padding="12" Spacing="8">
      <Button
          AutomationProperties.Name="{x:Bind local:Ui.Text('Detail_Set')}"
          Command="{x:Bind Detail.ApplyCommand}"
          Style="{StaticResource PrimaryButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Grid Width="16" Height="16">
            <FontIcon
                FontSize="16"
                Glyph="&#xE7F4;"
                Visibility="{x:Bind local:Ui.VisibleUnless(Detail.IsApplying), Mode=OneWay}" />
            <ProgressRing
                Width="16"
                Height="16"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                IsActive="{x:Bind Detail.IsApplying, Mode=OneWay}"
                Visibility="{x:Bind Detail.IsApplying, Mode=OneWay}" />
          </Grid>
          <TextBlock Text="{x:Bind local:Ui.Text('Detail_Set')}" />
        </StackPanel>
      </Button>
      <TextBlock
          HorizontalAlignment="Center"
          Style="{StaticResource TertiaryCaptionTextStyle}"
          Text="{x:Bind Detail.Attribution, Mode=OneWay}"
          TextTrimming="CharacterEllipsis"
          TextWrapping="NoWrap" />
    </StackPanel>
  </Grid>
</UserControl>
