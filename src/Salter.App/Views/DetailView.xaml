<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Salter.App.Views.DetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Salter.App.Controls"
    xmlns:local="using:Salter.App.Views"
    xmlns:vm="using:Salter.Presentation.ViewModels">

  <UserControl.Resources>
    <!-- One menu shared by every tag pill; its item is labelled for the pill it opens on. -->
    <MenuFlyout x:Key="TagMenu" Opening="OnTagMenuOpening">
      <MenuFlyoutItem Click="OnExcludeTagClick">
        <MenuFlyoutItem.Icon>
          <FontIcon Glyph="&#xED1A;" />
        </MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
    </MenuFlyout>
  </UserControl.Resources>

  <Grid Background="{ThemeResource SheetBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: back, resolution and size, open on wallhaven. -->
    <Grid Grid.Row="0" Padding="14,14,14,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
          x:Name="BackButton"
          Grid.Column="0"
          AutomationProperties.Name="{x:Bind local:Ui.Text('Detail_Back')}"
          Command="{x:Bind Detail.CloseCommand}"
          Style="{StaticResource IconButtonStyle}"
          ToolTipService.ToolTip="{x:Bind local:Ui.Text('Detail_Back')}">
        <FontIcon FontSize="16" Glyph="&#xE72B;" />
      </Button>
      <TextBlock
          Grid.Column="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="13"
          Foreground="{ThemeResource TextSecondaryBrush}"
          Text="{x:Bind Detail.Summary, Mode=OneWay}"
          TextTrimming="CharacterEllipsis" />
      <HyperlinkButton
          Grid.Column="2"
          AutomationProperties.Name="{x:Bind local:Ui.Text('Detail_OpenInBrowser')}"
          NavigateUri="{x:Bind Detail.WallhavenPage, Mode=OneWay}"
          Style="{StaticResource IconButtonStyle}"
          ToolTipService.ToolTip="{x:Bind local:Ui.Text('Detail_OpenInBrowser')}">
        <FontIcon FontSize="15" Glyph="&#xE8A7;" />
      </HyperlinkButton>
    </Grid>

    <!-- Preview, tags and target; scrolls when the flyout is shorter than usual. -->
    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
      <StackPanel Padding="14,0,14,14">
        <!-- The image is the frame's background, so the rounded corners clip it. -->
        <Border Height="194" Background="{ThemeResource ChipBrush}" CornerRadius="12">
          <Border
              x:Name="Preview"
              BorderBrush="{ThemeResource PreviewBorderBrush}"
              BorderThickness="1"
              CornerRadius="12" />
        </Border>

        <ItemsControl Margin="0,14,0,0" IsTabStop="False" ItemsSource="{x:Bind Detail.Tags, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <!-- Right-click (or press and hold) a pill to leave its tag out of the feed. -->
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border
                  Padding="10,4"
                  Background="{ThemeResource ChipBrush}"
                  ContextFlyout="{StaticResource TagMenu}"
                  CornerRadius="12"
                  Tag="{x:Bind}">
                <TextBlock FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}"><Run Text="#" /><Run Text="{x:Bind}" /></TextBlock>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Shown only with more than one display. -->
        <StackPanel Margin="0,18,0,0" Spacing="8" Visibility="{x:Bind Detail.ShowTargets, Mode=OneWay}">
          <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind local:Ui.Text('Detail_ApplyTo')}" />
          <Border
              Padding="3"
              Background="{ThemeResource FieldBrush}"
              BorderBrush="{ThemeResource GlassBorderBrush}"
              BorderThickness="1"
              CornerRadius="12">
            <ItemsRepeater ItemsSource="{x:Bind Detail.Targets, Mode=OneWay}">
              <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MaximumRowsOrColumns="3"
                    MinColumnSpacing="4"
                    MinItemWidth="60"
                    MinRowSpacing="4" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:ChoiceItem">
                  <RadioButton
                      Checked="OnTargetChecked"
                      Click="OnTargetClick"
                      Content="{x:Bind Label}"
                      GroupName="Target"
                      IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                      Style="{StaticResource SegmentRadioStyle}"
                      Tag="{x:Bind}" />
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Primary action and credit. -->
    <StackPanel Grid.Row="2" Padding="14" Spacing="8">
      <Button Command="{x:Bind Detail.ApplyCommand}" Style="{StaticResource PrimaryButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ProgressRing
              Width="16"
              Height="16"
              Foreground="{ThemeResource OnAccentBrush}"
              IsActive="{x:Bind Detail.IsApplying, Mode=OneWay}"
              Visibility="{x:Bind Detail.IsApplying, Mode=OneWay}" />
          <TextBlock Text="{x:Bind local:Ui.Text('Detail_Set')}" />
        </StackPanel>
      </Button>
      <TextBlock
          HorizontalAlignment="Center"
          FontSize="11"
          Foreground="{ThemeResource TextSecondaryBrush}"
          Text="{x:Bind Detail.Attribution, Mode=OneWay}"
          TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Grid>
</UserControl>
