<?xml version="1.0" encoding="utf-8"?>
<!--
  The flyout's content: a very light layer over the window's desktop acrylic with a 1 px surface stroke, rounded
  8 px like the Windows 11 window itself (so no plain acrylic shows in the corners), the screen being shown and the
  toast above every screen.
-->
<UserControl
    x:Class="Salter.App.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Salter.App.Views">

  <Border
      x:Name="Glass"
      Background="{ThemeResource GlassFillBrush}"
      BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8">
    <Grid>
      <!-- The feed, detail and settings screens; code-behind shows one at a time. -->
      <Grid x:Name="Pages" />

      <!--
        Toast: an InfoBar-like pill along the bottom, clear of the refresh button on the left. Code-behind fades it
        (Motion), so no transition is declared here.
      -->
      <Border
          x:Name="Toast"
          MinHeight="36"
          Margin="64,0,12,16"
          Padding="12,6,14,6"
          VerticalAlignment="Bottom"
          Background="{ThemeResource FloatingFillBrush}"
          BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource CardCornerRadius}"
          IsHitTestVisible="False"
          Opacity="0">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <FontIcon
              VerticalAlignment="Center"
              FontSize="14"
              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
              Glyph="&#xEC61;"
              Visibility="{x:Bind local:ShellView.SuccessVisibility(Shell.Toast.Kind), Mode=OneWay}" />
          <FontIcon
              VerticalAlignment="Center"
              FontSize="14"
              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
              Glyph="&#xEB90;"
              Visibility="{x:Bind local:ShellView.ErrorVisibility(Shell.Toast.Kind), Mode=OneWay}" />
          <TextBlock
              x:Name="ToastText"
              Grid.Column="1"
              VerticalAlignment="Center"
              AutomationProperties.LiveSetting="Polite"
              Style="{StaticResource BodyLineTextStyle}"
              Text="{x:Bind Shell.Toast.Message, Mode=OneWay}"
              TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
