<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Salter.App.Views.FeedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Salter.App.Views"
    xmlns:vm="using:Salter.Presentation.ViewModels"
    xmlns:wh="using:Salter.Core.Wallhaven">

  <UserControl.Resources>
    <!-- Pulses the loading placeholders; started and stopped with the loading state. -->
    <Storyboard x:Key="ShimmerStoryboard" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation
          Storyboard.TargetName="LoadingPanel"
          Storyboard.TargetProperty="Opacity"
          From="1"
          To="0.45"
          Duration="0:0:0.9" />
    </Storyboard>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: wordmark, filter toggle, settings. -->
    <Grid Grid.Row="0" Padding="20,18,14,10">
      <TextBlock
          VerticalAlignment="Center"
          AutomationProperties.HeadingLevel="Level1"
          CharacterSpacing="-40"
          FontFamily="Segoe UI Variable Display"
          FontSize="30"
          FontWeight="ExtraBold"
          Foreground="{ThemeResource TextPrimaryBrush}"
          LineHeight="30"
          LineStackingStrategy="BlockLineHeight"><Run Text="salt" /><Run Foreground="{ThemeResource AccentBrush}" Text="." /><Run Text="er" /></TextBlock>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
        <ToggleButton
            AutomationProperties.Name="{x:Bind local:Ui.Text('Feed_Filters')}"
            Command="{x:Bind Feed.ToggleFiltersCommand}"
            IsChecked="{x:Bind Feed.FiltersOpen, Mode=OneWay}"
            Style="{StaticResource ToggleIconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind local:Ui.Text('Feed_Filters')}">
          <FontIcon FontSize="16" Glyph="&#xE71C;" />
        </ToggleButton>
        <Button
            AutomationProperties.Name="{x:Bind local:Ui.Text('Feed_Settings')}"
            Command="{x:Bind Shell.ShowSettingsCommand}"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind local:Ui.Text('Feed_Settings')}">
          <FontIcon FontSize="16" Glyph="&#xE713;" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Search: Enter searches, Ctrl+K focuses the box. -->
    <Border
        Grid.Row="1"
        Height="38"
        Margin="14,4,14,10"
        Padding="12,0,8,0"
        Background="{ThemeResource FieldBrush}"
        BorderBrush="{ThemeResource GlassBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon
            Grid.Column="0"
            FontSize="14"
            Foreground="{ThemeResource TextPrimaryBrush}"
            Glyph="&#xE721;" />
        <TextBox
            x:Name="SearchBox"
            Grid.Column="1"
            Padding="0,6"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind local:Ui.Text('Search_Name')}"
            Background="Transparent"
            BorderThickness="0"
            FontSize="14"
            Foreground="{ThemeResource TextPrimaryBrush}"
            IsSpellCheckEnabled="False"
            KeyDown="OnSearchKeyDown"
            MinHeight="0"
            PlaceholderText="{x:Bind local:Ui.Text('Search_Placeholder')}"
            Text="{x:Bind Feed.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <!--
            Lightweight styling: the surrounding border is the field, so the box stays clear in every state. Text
            colours keep the theme defaults, which follow the flyout's theme.
          -->
          <TextBox.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </TextBox.Resources>
        </TextBox>
        <Border
            Grid.Column="2"
            Padding="5,1"
            VerticalAlignment="Center"
            BorderBrush="{ThemeResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
          <TextBlock
              FontSize="11"
              Foreground="{ThemeResource TextSecondaryBrush}"
              Text="{x:Bind local:Ui.Text('Search_ShortcutHint')}" />
        </Border>
      </Grid>
    </Border>

    <!-- Filters panel: ratio, minimum resolution, colour. -->
    <Border
        Grid.Row="2"
        Margin="14,0,14,10"
        Padding="12"
        Background="{ThemeResource FieldBrush}"
        BorderBrush="{ThemeResource GlassBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Visibility="{x:Bind Feed.FiltersOpen, Mode=OneWay}">
      <Grid ColumnSpacing="10" RowSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="74" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextStyle}"
            Text="{x:Bind local:Ui.Text('Filter_Ratio')}" />
        <ItemsRepeater Grid.Row="0" Grid.Column="1" ItemsSource="{x:Bind Feed.Ratios}">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="4" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceItem">
              <RadioButton
                  Height="26"
                  Checked="OnRatioChecked"
                  Click="OnRatioClick"
                  Content="{x:Bind Label}"
                  CornerRadius="13"
                  GroupName="Ratio"
                  IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                  Style="{StaticResource ChipRadioStyle}"
                  Tag="{x:Bind}" />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <TextBlock
            Grid.Row="1"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextStyle}"
            Text="{x:Bind local:Ui.Text('Filter_Resolution')}" />
        <ItemsRepeater Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind Feed.Resolutions}">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="4" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceItem">
              <RadioButton
                  Height="26"
                  Checked="OnResolutionChecked"
                  Click="OnResolutionClick"
                  Content="{x:Bind Label}"
                  CornerRadius="13"
                  GroupName="Resolution"
                  IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                  Style="{StaticResource ChipRadioStyle}"
                  Tag="{x:Bind}" />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <TextBlock
            Grid.Row="2"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextStyle}"
            Text="{x:Bind local:Ui.Text('Filter_Color')}" />
        <!-- Each swatch's colour is set when it is prepared; choosing the selected one again clears the filter. -->
        <ItemsRepeater
            Grid.Row="2"
            Grid.Column="1"
            VerticalAlignment="Center"
            ElementPrepared="OnColorPrepared"
            ItemsSource="{x:Bind Feed.Colors}">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="6" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceItem">
              <RadioButton
                  AutomationProperties.Name="{x:Bind Label}"
                  Checked="OnColorChecked"
                  Click="OnColorClick"
                  GroupName="Color"
                  IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                  Style="{StaticResource SwatchRadioStyle}"
                  Tag="{x:Bind}"
                  ToolTipService.ToolTip="{x:Bind Label}" />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </Grid>
    </Border>

    <!-- Genres: one scrollable line, no visible scroll bar; the mouse wheel scrolls it sideways. -->
    <ScrollViewer
        x:Name="GenreScroller"
        Grid.Row="3"
        HorizontalScrollBarVisibility="Hidden"
        HorizontalScrollMode="Enabled"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">
      <ItemsRepeater Margin="14,0,14,10" ItemsSource="{x:Bind Feed.Genres}">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Horizontal" Spacing="6" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:ChoiceItem">
            <RadioButton
                Checked="OnGenreChecked"
                Click="OnGenreClick"
                Content="{x:Bind Label}"
                GroupName="Genre"
                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                Style="{StaticResource ChipRadioStyle}"
                Tag="{x:Bind}" />
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </ScrollViewer>

    <!-- Sort tabs, evenly spread, above a hairline. -->
    <Border
        Grid.Row="4"
        Padding="10,2,10,0"
        BorderBrush="{ThemeResource GlassBorderBrush}"
        BorderThickness="0,0,0,1">
      <ItemsRepeater ItemsSource="{x:Bind Feed.Sortings}">
        <ItemsRepeater.Layout>
          <UniformGridLayout ItemsStretch="Fill" MaximumRowsOrColumns="4" MinItemWidth="40" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:ChoiceItem">
            <RadioButton
                Checked="OnSortingChecked"
                Click="OnSortingClick"
                Content="{x:Bind Label}"
                GroupName="Sorting"
                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                Style="{StaticResource TabRadioStyle}"
                Tag="{x:Bind}" />
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </Border>

    <!-- Results. -->
    <Grid Grid.Row="5">
      <ScrollViewer
          x:Name="FeedScroller"
          HorizontalScrollMode="Disabled"
          VerticalScrollBarVisibility="Hidden"
          ViewChanged="OnFeedViewChanged"
          Visibility="{x:Bind local:FeedView.ResultsVisibility(Feed.State), Mode=OneWay}">
        <StackPanel>
          <ItemsRepeater
              ElementClearing="OnThumbnailClearing"
              ElementPrepared="OnThumbnailPrepared"
              ItemsSource="{x:Bind Feed.Items}"
              SizeChanged="OnFeedSizeChanged"
              TabFocusNavigation="Once"
              XYFocusKeyboardNavigation="Enabled">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="2" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <!--
                Parts are found by position in code-behind: the image first, then the hover overlay. The overlay, and
                so its Set button, takes clicks only while shown.
              -->
              <DataTemplate x:DataType="wh:WallpaperSummary">
                <Button
                    Height="196"
                    AutomationProperties.Name="{x:Bind Resolution}"
                    Click="OnThumbnailClick"
                    GotFocus="OnThumbnailGotFocus"
                    LostFocus="OnThumbnailLostFocus"
                    PointerEntered="OnThumbnailPointerEntered"
                    PointerExited="OnThumbnailPointerExited"
                    Style="{StaticResource ThumbnailButtonStyle}"
                    Tag="{x:Bind}">
                  <Grid Background="{ThemeResource ChipBrush}">
                    <Image HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill" />
                    <Grid
                        Padding="12,26,12,10"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource ThumbnailOverlayBrush}"
                        IsHitTestVisible="False"
                        Opacity="0">
                      <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.18" />
                      </Grid.OpacityTransition>
                      <TextBlock
                          VerticalAlignment="Center"
                          FontSize="12"
                          FontWeight="Medium"
                          Foreground="{ThemeResource FloatingTextBrush}"
                          Text="{x:Bind Resolution}" />
                      <Button
                          HorizontalAlignment="Right"
                          AutomationProperties.Name="{x:Bind local:Ui.Text('Detail_Set')}"
                          Click="OnQuickApplyClick"
                          Content="{x:Bind local:Ui.Text('Feed_Set')}"
                          Style="{StaticResource PillButtonStyle}"
                          Tag="{x:Bind}" />
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>

          <!-- Footer: a further page is loading, or loading it failed and waits for the user to retry. -->
          <ProgressRing
              Width="20"
              Height="20"
              Margin="0,12,0,64"
              IsActive="{x:Bind Feed.IsLoadingMore, Mode=OneWay}"
              Visibility="{x:Bind Feed.IsLoadingMore, Mode=OneWay}" />
          <StackPanel
              Margin="14,12,14,64"
              HorizontalAlignment="Center"
              Spacing="8"
              Visibility="{x:Bind Feed.LoadMoreFailed, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextStyle}"
                Text="{x:Bind Feed.ErrorMessage, Mode=OneWay}"
                TextAlignment="Center" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind Feed.RetryLoadMoreCommand}"
                Content="{x:Bind local:Ui.Text('State_Retry')}"
                Style="{StaticResource SecondaryButtonStyle}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Loading: three pulsing placeholders. -->
      <StackPanel
          x:Name="LoadingPanel"
          Spacing="2"
          Visibility="{x:Bind local:FeedView.LoadingVisibility(Feed.State), Mode=OneWay}">
        <Border Height="196" Background="{ThemeResource ChipBrush}" />
        <Border Height="196" Background="{ThemeResource ChipBrush}" />
        <Border Height="196" Background="{ThemeResource ChipBrush}" />
      </StackPanel>

      <!-- Empty. -->
      <StackPanel
          Margin="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="12"
          Visibility="{x:Bind local:FeedView.EmptyVisibility(Feed.State), Mode=OneWay}">
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="{ThemeResource TextPrimaryBrush}"
            Text="{x:Bind local:Ui.Text('State_Empty')}" />
        <Button
            HorizontalAlignment="Center"
            Command="{x:Bind Feed.ResetFiltersCommand}"
            Content="{x:Bind local:Ui.Text('State_ResetFilters')}"
            Style="{StaticResource SecondaryButtonStyle}" />
      </StackPanel>

      <!-- Error. -->
      <StackPanel
          Margin="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="12"
          Visibility="{x:Bind local:FeedView.ErrorVisibility(Feed.State), Mode=OneWay}">
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="{ThemeResource TextPrimaryBrush}"
            Text="{x:Bind Feed.ErrorMessage, Mode=OneWay}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            HorizontalAlignment="Center"
            Command="{x:Bind Feed.LoadCommand}"
            Content="{x:Bind local:Ui.Text('State_Retry')}"
            Style="{StaticResource SecondaryButtonStyle}" />
      </StackPanel>

      <!-- Floating refresh, 14 px from the bottom-left corner. -->
      <Button
          Margin="14"
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom"
          AutomationProperties.Name="{x:Bind local:Ui.Text('Feed_Refresh')}"
          Command="{x:Bind Feed.RefreshCommand}"
          Style="{StaticResource FloatingButtonStyle}"
          ToolTipService.ToolTip="{x:Bind local:Ui.Text('Feed_Refresh')}">
        <FontIcon FontSize="16" Glyph="&#xE72C;" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
