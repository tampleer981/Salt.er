<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Salter.App.Views.FeedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Salter.App.Views"
    xmlns:vm="using:Salter.Presentation.ViewModels"
    xmlns:controls="using:Salter.App.Controls"
    xmlns:wh="using:Salter.Core.Wallhaven">

  <UserControl.Resources>
    <!-- Pulses the loading placeholders; started and stopped with the loading state. -->
    <Storyboard x:Key="ShimmerStoryboard" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation
          Storyboard.TargetName="LoadingPanel"
          Storyboard.TargetProperty="Opacity"
          From="1"
          To="0.45"
          Duration="0:0:0.9" />
    </Storyboard>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header, like a title bar: brand mark and name, then filter toggle and settings; a hairline below. -->
    <Grid Grid.Row="0" Height="48" Padding="16,0,8,0" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- The tray icon's wallpaper strip, drawn in XAML: no image file to load. -->
      <Border
          Width="11"
          Height="16"
          VerticalAlignment="Center"
          Background="{StaticResource BrandMarkBrush}"
          BorderBrush="{StaticResource BrandMarkStrokeBrush}"
          BorderThickness="1"
          CornerRadius="3" />
      <TextBlock
          Grid.Column="1"
          AutomationProperties.HeadingLevel="Level1"
          Style="{StaticResource WindowTitleTextStyle}"><Run Text="Salt" /><Run Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="." /><Run Text="er" /></TextBlock>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
        <ToggleButton
            AutomationProperties.Name="{x:Bind local:Ui.Text('Feed_Filters')}"
            Command="{x:Bind Feed.ToggleFiltersCommand}"
            IsChecked="{x:Bind Feed.FiltersOpen, Mode=OneWay}"
            Style="{StaticResource TitleBarToggleButtonStyle}"
            ToolTipService.ToolTip="{x:Bind local:Ui.Text('Feed_Filters')}">
          <FontIcon FontSize="16" Glyph="&#xE71C;" />
        </ToggleButton>
        <Button
            AutomationProperties.Name="{x:Bind local:Ui.Text('Feed_Settings')}"
            Command="{x:Bind Shell.ShowSettingsCommand}"
            Style="{StaticResource TitleBarButtonStyle}"
            ToolTipService.ToolTip="{x:Bind local:Ui.Text('Feed_Settings')}">
          <FontIcon FontSize="16" Glyph="&#xE713;" />
        </Button>
      </StackPanel>
      <Rectangle Grid.ColumnSpan="3" Margin="-16,0,-8,0" VerticalAlignment="Bottom" Style="{StaticResource DividerStyle}" />
    </Grid>

    <!--
      Search: the default Fluent text box (translucent fill, accent underline while focused) with a leading search
      glyph and the Ctrl+K hint while it is empty. Enter searches.
    -->
    <Grid Grid.Row="1" Margin="12,12,12,8">
      <TextBox
          x:Name="SearchBox"
          MinHeight="36"
          Padding="36,7,52,6"
          VerticalContentAlignment="Center"
          AutomationProperties.Name="{x:Bind local:Ui.Text('Search_Name')}"
          IsSpellCheckEnabled="False"
          KeyDown="OnSearchKeyDown"
          PlaceholderText="{x:Bind local:Ui.Text('Search_Placeholder')}"
          Text="{x:Bind Feed.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <FontIcon
          Margin="12,0,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          FontSize="14"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Glyph="&#xE721;"
          IsHitTestVisible="False" />
      <Border
          Margin="0,0,8,0"
          Padding="6,1,6,2"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{ThemeResource ControlCornerRadius}"
          IsHitTestVisible="False"
          Visibility="{x:Bind local:Ui.VisibleWhenEmpty(Feed.SearchText), Mode=OneWay}">
        <TextBlock
            FontSize="11"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="{x:Bind local:Ui.Text('Search_ShortcutHint')}" />
      </Border>
    </Grid>

    <!-- Filters panel: a card with labelled rows (ratio, minimum resolution, colour, excluded tags). -->
    <Border
        Grid.Row="2"
        Margin="12,0,12,8"
        Style="{StaticResource CardStyle}"
        Visibility="{x:Bind Feed.FiltersOpen, Mode=OneWay}">
      <Grid ColumnSpacing="10" RowSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextStyle}"
            Text="{x:Bind local:Ui.Text('Filter_Ratio')}" />
        <ItemsRepeater Grid.Row="0" Grid.Column="1" ItemsSource="{x:Bind Feed.Ratios}">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="4" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceItem">
              <RadioButton
                  Height="26"
                  Padding="10,0"
                  Checked="OnRatioChecked"
                  Click="OnRatioClick"
                  Content="{x:Bind Label}"
                  CornerRadius="{StaticResource SmallPillCornerRadius}"
                  GroupName="Ratio"
                  IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                  Style="{StaticResource ChipRadioStyle}"
                  Tag="{x:Bind}" />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <TextBlock
            Grid.Row="1"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextStyle}"
            Text="{x:Bind local:Ui.Text('Filter_Resolution')}" />
        <ItemsRepeater Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind Feed.Resolutions}">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="4" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceItem">
              <RadioButton
                  Height="26"
                  Padding="10,0"
                  Checked="OnResolutionChecked"
                  Click="OnResolutionClick"
                  Content="{x:Bind Label}"
                  CornerRadius="{StaticResource SmallPillCornerRadius}"
                  GroupName="Resolution"
                  IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                  Style="{StaticResource ChipRadioStyle}"
                  Tag="{x:Bind}" />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <TextBlock
            Grid.Row="2"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextStyle}"
            Text="{x:Bind local:Ui.Text('Filter_Color')}" />
        <!-- Each swatch's colour is set when it is prepared; choosing the selected one again clears the filter. -->
        <ItemsRepeater
            Grid.Row="2"
            Grid.Column="1"
            VerticalAlignment="Center"
            ElementPrepared="OnColorPrepared"
            ItemsSource="{x:Bind Feed.Colors}">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="4" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceItem">
              <RadioButton
                  AutomationProperties.Name="{x:Bind Label}"
                  Checked="OnColorChecked"
                  Click="OnColorClick"
                  GroupName="Color"
                  IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                  Style="{StaticResource SwatchRadioStyle}"
                  Tag="{x:Bind}"
                  ToolTipService.ToolTip="{x:Bind Label}" />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- Excluded tags: Enter adds the typed tag; each chip's × shows the tag's wallpapers again. -->
        <TextBlock
            Grid.Row="3"
            Margin="0,7,0,0"
            VerticalAlignment="Top"
            Style="{StaticResource CaptionTextStyle}"
            Text="{x:Bind local:Ui.Text('Filter_Exclude')}" />
        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
          <TextBox
              x:Name="ExclusionBox"
              MinHeight="30"
              Padding="10,5,6,5"
              AutomationProperties.Name="{x:Bind local:Ui.Text('Filter_ExcludeName')}"
              FontSize="12"
              IsSpellCheckEnabled="False"
              KeyDown="OnExclusionKeyDown"
              MaxLength="40"
              PlaceholderText="{x:Bind local:Ui.Text('Filter_ExcludePlaceholder')}"
              Text="{x:Bind Feed.ExclusionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <ItemsControl x:Name="ExclusionChips" IsTabStop="False" ItemsSource="{x:Bind Feed.ExcludedTags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Grid
                    Height="26"
                    Padding="10,0,3,0"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="2"
                    CornerRadius="{StaticResource SmallPillCornerRadius}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"><Run Text="#" /><Run Text="{x:Bind}" /></TextBlock>
                  <!-- Named "Remove <tag>" for screen readers when loaded. -->
                  <Button
                      Grid.Column="1"
                      Width="20"
                      Height="20"
                      Padding="0"
                      Click="OnRemoveExclusionClick"
                      CornerRadius="10"
                      Loaded="OnRemoveExclusionLoaded"
                      Style="{StaticResource SubtleButtonStyle}"
                      Tag="{x:Bind}">
                    <FontIcon FontSize="8" Glyph="&#xE711;" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Genres: one scrollable line of pills, no visible scroll bar; the mouse wheel scrolls it sideways. -->
    <ScrollViewer
        x:Name="GenreScroller"
        Grid.Row="3"
        HorizontalScrollBarVisibility="Hidden"
        HorizontalScrollMode="Enabled"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">
      <ItemsRepeater Margin="12,0,12,4" ItemsSource="{x:Bind Feed.Genres}">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Horizontal" Spacing="6" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:ChoiceItem">
            <RadioButton
                Checked="OnGenreChecked"
                Click="OnGenreClick"
                Content="{x:Bind Label}"
                GroupName="Genre"
                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                Style="{StaticResource ChipRadioStyle}"
                Tag="{x:Bind}" />
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </ScrollViewer>

    <!-- Sort tabs: the WinUI SelectorBar (accent pill under the selected item); items are added in code-behind. -->
    <Grid Grid.Row="4">
      <SelectorBar
          x:Name="SortBar"
          Margin="4,0,4,0"
          AutomationProperties.Name="{x:Bind local:Ui.Text('Feed_Sort')}"
          SelectionChanged="OnSortSelectionChanged" />
      <Rectangle VerticalAlignment="Bottom" Style="{StaticResource DividerStyle}" />
    </Grid>

    <!-- Results. -->
    <Grid Grid.Row="5">
      <ScrollViewer
          x:Name="FeedScroller"
          HorizontalScrollMode="Disabled"
          VerticalScrollBarVisibility="Hidden"
          ViewChanged="OnFeedViewChanged"
          Visibility="{x:Bind local:FeedView.ResultsVisibility(Feed.State), Mode=OneWay}">
        <StackPanel Padding="12,8,12,0">
          <!-- Three viewports of realized items, so thumbnails are ready before they scroll into view. -->
          <ItemsRepeater
              ElementClearing="OnThumbnailClearing"
              ElementPrepared="OnThumbnailPrepared"
              ItemsSource="{x:Bind Feed.Items}"
              SizeChanged="OnFeedSizeChanged"
              TabFocusNavigation="Once"
              VerticalCacheLength="3"
              XYFocusKeyboardNavigation="Enabled">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <!--
                A rounded card. Parts are found by position in code-behind: the image layer first (its ImageBrush is
                set there, so the rounded corners clip the image), then the hover overlay. The overlay, and so its
                Set button, takes clicks only while shown. Both fade through Motion; nothing animates in markup.
              -->
              <DataTemplate x:DataType="wh:WallpaperSummary">
                <Button
                    Height="196"
                    AutomationProperties.Name="{x:Bind Resolution}"
                    Click="OnThumbnailClick"
                    GotFocus="OnThumbnailGotFocus"
                    LostFocus="OnThumbnailLostFocus"
                    PointerEntered="OnThumbnailPointerEntered"
                    PointerExited="OnThumbnailPointerExited"
                    Style="{StaticResource ThumbnailButtonStyle}"
                    Tag="{x:Bind}">
                  <Grid Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource CardCornerRadius}">
                    <Border CornerRadius="{StaticResource CardCornerRadius}" Opacity="0" />
                    <Grid IsHitTestVisible="False" Opacity="0">
                      <!-- A lighter hairline marks the card under the pointer. -->
                      <Border
                          BorderBrush="{StaticResource OnImageStrokeBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardCornerRadius}" />
                      <Grid
                          Padding="12,26,10,10"
                          VerticalAlignment="Bottom"
                          Background="{StaticResource ThumbnailOverlayBrush}"
                          CornerRadius="0,0,8,8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource OnImageTextBrush}"
                            Text="{x:Bind Resolution}" />
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="{x:Bind local:Ui.Text('Detail_Set')}"
                            Click="OnQuickApplyClick"
                            Content="{x:Bind local:Ui.Text('Feed_Set')}"
                            Style="{StaticResource QuickSetButtonStyle}"
                            Tag="{x:Bind}" />
                      </Grid>
                    </Grid>
                    <!-- The card's hairline, above the image. -->
                    <Border
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        IsHitTestVisible="False" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>

          <!-- Footer: a further page is loading, or loading it failed and waits for the user to retry. -->
          <ProgressRing
              Width="20"
              Height="20"
              Margin="0,12,0,64"
              IsActive="{x:Bind Feed.IsLoadingMore, Mode=OneWay}"
              Visibility="{x:Bind Feed.IsLoadingMore, Mode=OneWay}" />
          <StackPanel
              Margin="2,12,2,64"
              HorizontalAlignment="Center"
              Spacing="8"
              Visibility="{x:Bind Feed.LoadMoreFailed, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextStyle}"
                Text="{x:Bind Feed.ErrorMessage, Mode=OneWay}"
                TextAlignment="Center" />
            <Button
                HorizontalAlignment="Center"
                AutomationProperties.Name="{x:Bind local:Ui.Text('State_Retry')}"
                Command="{x:Bind Feed.RetryLoadMoreCommand}"
                Style="{StaticResource SecondaryButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                <TextBlock Text="{x:Bind local:Ui.Text('State_Retry')}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Loading: three pulsing placeholder cards. -->
      <StackPanel
          x:Name="LoadingPanel"
          Padding="12,8,12,0"
          Spacing="8"
          Visibility="{x:Bind local:FeedView.LoadingVisibility(Feed.State), Mode=OneWay}">
        <Border Height="196" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource CardCornerRadius}" />
        <Border Height="196" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource CardCornerRadius}" />
        <Border Height="196" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource CardCornerRadius}" />
      </StackPanel>

      <!-- Empty. -->
      <StackPanel
          Margin="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="12"
          Visibility="{x:Bind local:FeedView.EmptyVisibility(Feed.State), Mode=OneWay}">
        <FontIcon
            HorizontalAlignment="Center"
            FontSize="32"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Glyph="&#xE721;" />
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind local:Ui.Text('State_Empty')}"
            TextAlignment="Center" />
        <Button
            HorizontalAlignment="Center"
            AutomationProperties.Name="{x:Bind local:Ui.Text('State_ResetFilters')}"
            Command="{x:Bind Feed.ResetFiltersCommand}"
            Style="{StaticResource SecondaryButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Glyph="&#xE894;" />
            <TextBlock Text="{x:Bind local:Ui.Text('State_ResetFilters')}" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Error. -->
      <StackPanel
          Margin="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="12"
          Visibility="{x:Bind local:FeedView.ErrorVisibility(Feed.State), Mode=OneWay}">
        <FontIcon
            HorizontalAlignment="Center"
            FontSize="32"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Glyph="&#xE783;" />
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{x:Bind Feed.ErrorMessage, Mode=OneWay}"
            TextAlignment="Center" />
        <Button
            HorizontalAlignment="Center"
            AutomationProperties.Name="{x:Bind local:Ui.Text('State_Retry')}"
            Command="{x:Bind Feed.LoadCommand}"
            Style="{StaticResource SecondaryButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Glyph="&#xE72C;" />
            <TextBlock Text="{x:Bind local:Ui.Text('State_Retry')}" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Floating refresh, 12 px from the bottom-left corner. -->
      <Button
          Margin="12,12,12,14"
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom"
          AutomationProperties.Name="{x:Bind local:Ui.Text('Feed_Refresh')}"
          Command="{x:Bind Feed.RefreshCommand}"
          Style="{StaticResource FloatingButtonStyle}"
          ToolTipService.ToolTip="{x:Bind local:Ui.Text('Feed_Refresh')}">
        <FontIcon FontSize="16" Glyph="&#xE72C;" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
