<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Salter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="ms-appx:///Styles/Glass.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        Styles based on the WinUI defaults (buttons, type ramp) live here rather than in Styles/: a {StaticResource}
        in the app dictionary itself is certain to find the keys of its merged dictionaries, XamlControlsResources
        and Styles/Glass.xaml included. Styles/Controls.xaml holds the custom templates, which use {ThemeResource}.
      -->
      <!-- 32 × 32 title-bar style icon button: header actions, back. -->
      <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>

      <!-- The same for a link (open on wallhaven): the default hyperlink button, sized like the others. -->
      <Style x:Key="TitleBarLinkButtonStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>

      <!-- Primary action: the accent button, full width. -->
      <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
      </Style>

      <!-- Secondary actions (retry, reset, save, change): the default outlined button. -->
      <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
      </Style>

      <!-- The small accent "Set" button on a hovered thumbnail. -->
      <Style x:Key="QuickSetButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Padding" Value="12,4,12,5" />
        <Setter Property="FontSize" Value="12" />
      </Style>

      <!-- The app name in a header, Display cut. -->
      <Style x:Key="WindowTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>

      <!-- A screen title (Settings). -->
      <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>

      <!-- A group header above cards. -->
      <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="2,16,0,6" />
      </Style>

      <!-- Small secondary caption: field labels, hints, descriptions. -->
      <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      </Style>

      <!-- Faint metadata: attribution, disclaimer. -->
      <Style x:Key="TertiaryCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
      </Style>

      <!-- Primary body text that stays on one line. -->
      <Style x:Key="BodyLineTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
