<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the content root lives in markup. The backdrop and the keyboard accelerators are set up in code-behind, where a
  failure raises a specific exception instead of a bare XAML parse error that aborts the whole window.
-->
<Window
    x:Class="Salter.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid x:Name="Root">
    <!-- Shown only when desktop acrylic is unavailable, so the flyout keeps a clean dark-to-gray gradient. -->
    <Border
        x:Name="FallbackBackground"
        Background="{ThemeResource FallbackWindowBrush}"
        CornerRadius="8"
        Visibility="Collapsed" />
    <Grid x:Name="ContentHost" />
  </Grid>
</Window>
