<?xml version="1.0" encoding="utf-8"?>
<!--
  The few colours of the flyout that the WinUI theme resources do not cover. Everything else (text, control fills,
  strokes, cards, accent) comes from the system's Fluent theme resources, so the flyout follows the light or dark
  theme and the user's accent colour. Theme-dependent brushes switch with the flyout's RequestedTheme; reference them
  with {ThemeResource}. docs/design.md maps every token to its resource.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <!-- Dark; also used for any theme without its own dictionary. -->
    <ResourceDictionary x:Key="Default">
      <!-- A very light layer over the window's desktop acrylic: the blurred desktop shows through. -->
      <SolidColorBrush x:Key="GlassFillBrush" Color="#2E000000" />
      <!-- Shown instead of the acrylic when it is unavailable (transparency off, battery saver, Windows 10). -->
      <LinearGradientBrush x:Key="FallbackWindowBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="#FF0B0D10" />
        <GradientStop Offset="1" Color="#FF242830" />
      </LinearGradientBrush>
      <!-- Controls that float over wallpapers (refresh, toast): nearly opaque, so they read on any image. -->
      <SolidColorBrush x:Key="FloatingFillBrush" Color="#E62C2C2C" />
      <SolidColorBrush x:Key="FloatingFillPointerOverBrush" Color="#F2383838" />
      <SolidColorBrush x:Key="FloatingFillPressedBrush" Color="#F2262626" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="GlassFillBrush" Color="#40FFFFFF" />
      <LinearGradientBrush x:Key="FallbackWindowBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="#FFF7F8FA" />
        <GradientStop Offset="1" Color="#FFE8ECF2" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="FloatingFillBrush" Color="#F0FBFBFB" />
      <SolidColorBrush x:Key="FloatingFillPointerOverBrush" Color="#F7F3F3F3" />
      <SolidColorBrush x:Key="FloatingFillPressedBrush" Color="#F7EBEBEB" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Over wallpapers, whatever the theme: white text and a hairline on a darkening gradient. -->
  <SolidColorBrush x:Key="OnImageTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="OnImageStrokeBrush" Color="#59FFFFFF" />
  <LinearGradientBrush x:Key="ThumbnailOverlayBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#00000000" />
    <GradientStop Offset="1" Color="#99000000" />
  </LinearGradientBrush>

  <!-- The brand mark in the header: the tray icon's wallpaper strip. -->
  <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#FFFFA6D9" />
    <GradientStop Offset="0.30" Color="#FFFFB38A" />
    <GradientStop Offset="0.48" Color="#FFF2588F" />
    <GradientStop Offset="0.62" Color="#FF4A1F4F" />
    <GradientStop Offset="0.70" Color="#FFC9A4FF" />
    <GradientStop Offset="0.86" Color="#FF8A5CF0" />
    <GradientStop Offset="1" Color="#FF4B2F9E" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="BrandMarkStrokeBrush" Color="#D9FFFFFF" />

  <!--
    Titles use the Display cut; body copy keeps the type ramp's XamlAutoFontFamily (Segoe UI Variable Text on
    Windows 11). Segoe UI stands in where the variable font is missing (Windows 10).
  -->
  <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

  <!-- Geometry. -->
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="PillCornerRadius">15</CornerRadius>
  <CornerRadius x:Key="SmallPillCornerRadius">13</CornerRadius>

</ResourceDictionary>
